# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5

# Tavily web search (https://app.tavily.com)
# Uses normal DNS and standard HTTP_PROXY/HTTPS_PROXY/NO_PROXY settings.
# Requests go only to the fixed HTTPS search endpoint; redirects are disabled.
TAVILY_API_KEY=tvly-...

# Discord (optional — if set, Discord adapter is used instead of CLI)
DISCORD_TOKEN=

# Optional prompt overrides: directory containing both soul.md and instructions.md.
# Empty/unset (or neither file present) uses the embedded defaults.
PROMPTS_DIR=

# Session
SESSION_TIMEOUT_MINUTES=30
CONVERSATION_HISTORY_WINDOW_SIZE=20

# Public web research (mandatory private/metadata blocking; no credential headers)
HTTP_FETCH_ENABLED=true
# Empty permits public hosts. Comma-separated exact hosts or *.example.com
# (wildcards match subdomains only). Denials always take precedence.
HTTP_FETCH_ALLOWED_HOSTS=
HTTP_FETCH_DENIED_HOSTS=
# http:80 and https:443; explicitly list other public ports if needed.
HTTP_FETCH_ALLOWED_PORTS=80,443
# GET/HEAD only by default. Mutations require BOTH true and destination hosts.
# Authorization/Cookie headers remain forbidden even when mutations are enabled.
HTTP_FETCH_ALLOW_MUTATIONS=false
HTTP_FETCH_MUTATION_ALLOWED_HOSTS=
# Positive integer limits; the caller can shorten, never extend this timeout.
HTTP_FETCH_MAX_TIMEOUT_MS=30000
HTTP_FETCH_MAX_RESPONSE_BYTES=524288
HTTP_FETCH_MAX_TEXT_BYTES=65536
# Nonnegative; 0 disables redirects. Mutations never follow redirects.
HTTP_FETCH_MAX_REDIRECTS=5
